{
  "name": "genie-midnight-run",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check:map": "node --experimental-strip-types scripts/check-map.mjs",
    "check:collisions": "node --experimental-strip-types scripts/check-collisions.mjs",
    "build:pages": "npm run check:map && npm run check:collisions && tsc --noEmit && vite build --base /genie-midnight-run/",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
